<!--
  Edu Shorts launcher icon — foreground layer (adaptive icon).

  Design:
    • A vertical rounded "phone-short" capsule (the brand metaphor for a
      vertical video reel) in the brand gradient (pink → blue with a hint
      of warm coral mid-stop), centered inside the 108x108 adaptive-icon
      viewport.
    • A white play triangle sits dead-center inside the capsule.

  The shapes fit inside the 72x72 safe zone (margin 18 on each side) so
  they're never clipped by any launcher mask (square, round, squircle).
  Sits over the dark-indigo background defined in values/colors.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow halo — soft accent ring, helps the icon read on busy
         wallpapers without competing with the capsule. -->
    <path
        android:pathData="M 54 22 m -32 0 a 32 32 0 1 0 64 0 a 32 32 0 1 0 -64 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38"
                android:startColor="#33FF3B6B"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Vertical capsule (rounded rectangle) with the brand gradient -->
    <path android:pathData="M 44 22 L 64 22 A 10 10 0 0 1 74 32 L 74 76 A 10 10 0 0 1 64 86 L 44 86 A 10 10 0 0 1 34 76 L 34 32 A 10 10 0 0 1 44 22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="22"
                android:endX="74"
                android:endY="86">
                <item android:offset="0.0" android:color="#FF3B6B" />
                <item android:offset="0.55" android:color="#FF6B6B" />
                <item android:offset="1.0" android:color="#6B8CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White play triangle, centered in the capsule -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48 42 L 48 66 L 66 54 Z" />
</vector>
